          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Signature Mismatch (last 1h)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
