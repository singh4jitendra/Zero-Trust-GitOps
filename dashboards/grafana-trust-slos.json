        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(kyverno_admission_requests_total{rule_name=\"verify-bank-api-images\", resource_response=\"fail\"}[1h]))",
